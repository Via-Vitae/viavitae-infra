# Managed by ansible/roles/hardening. Edit the role, not this file.
#
# This is the whole SSH policy in one file, so that a reviewer does not have to
# reconstruct it from a distribution default plus a diff.

Port {{ hardening_ssh_port }}
AddressFamily inet
ListenAddress 0.0.0.0

# Key-only. Password authentication against a service reachable from the management
# VLAN is a credential-stuffing target, and fail2ban slows that down rather than
# stopping it.
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey
PermitRootLogin {{ sshd_permit_root_login }}
MaxAuthTries {{ hardening_ssh_max_auth_tries }}
MaxStartups 10:30:60
LoginGraceTime {{ hardening_ssh_login_grace_time }}

# Only the named group may log in. An account that exists for another reason — a
# service account, a vendor installer, a forgotten contractor — is not an SSH account
# just because it has a shell.
AllowGroups {{ hardening_ssh_allow_groups | join(' ') }}

ClientAliveInterval {{ hardening_ssh_client_alive_interval }}
ClientAliveCountMax {{ hardening_ssh_client_alive_count_max }}
TCPKeepAlive no

X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
# No forwarding and no tunnel: the management VLAN is reachable from the runners, and a
# tunnel through a compromised guest is a route into it that no firewall rule describes.
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no

# Modern algorithms only. The distributions' defaults still permit several that exist
# for compatibility with clients this estate does not have.
KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256

Banner /etc/issue.net
PrintMotd no
PrintLastLog yes
UseDNS no
# `UseDNS no` is not a performance preference: a reverse lookup that times out delays
# every login by 30 seconds, and during an incident that delay is paid per host per
# attempt, by the person trying to fix the incident.

# Auditing and logging.
LogLevel VERBOSE
SyslogFacility AUTHPRIV
# The banner is a notice, not a consent gate. It states that the system is monitored
# and says nothing that could be read as an invitation, because a login banner that
# discloses version numbers is reconnaissance handed to whoever is scanning.
